{
  "name": "incibase",
  "version": "0.1.0",
  "description": "Zod-typed backend-as-a-service in a single Bun binary: realtime queries, auth, storage, scheduling and MCP.",
  "license": "MIT",
  "author": "Ömer Genç <omergnc1@gmail.com>",
  "homepage": "https://github.com/omer-genc/incibase#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omer-genc/incibase.git"
  },
  "bugs": {
    "url": "https://github.com/omer-genc/incibase/issues"
  },
  "keywords": [
    "bun",
    "backend",
    "baas",
    "realtime",
    "sqlite",
    "zod",
    "convex",
    "pocketbase",
    "mcp"
  ],
  "type": "module",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "bin": {
    "incibase": "./src/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./server": {
      "types": "./dist/lib/server.d.ts",
      "default": "./dist/lib/server.js"
    },
    "./client": {
      "types": "./dist/lib/client.d.ts",
      "default": "./dist/lib/client.js"
    },
    "./react": {
      "types": "./dist/lib/react.d.ts",
      "default": "./dist/lib/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib",
    "src",
    "!src/dashboard"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "bun check",
    "test": "bun test",
    "build:binary": "bun scripts/build-binary.ts",
    "build:package": "bun scripts/build-package.ts",
    "prepublishOnly": "bun run typecheck && bun test && bun run build:package"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "happy-dom": "21.0.4",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "typescript": "^7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
